#!/usr/bin/env python3
"""cosmic-mission-control: macOS-style four-finger gestures for the COSMIC desktop.

    up          open the Workspaces Overview
    down        close the overview, or open the App Library from the desktop
    left/right  inside the overview: switch workspace, overview stays open
                on the desktop: left to COSMIC, which already handles it
    3 fingers   drag: move three fingers to hold the left button (macOS three-finger drag)

Design
  * One process, one GLib main loop. No threads, no helper processes per gesture.
  * The overview is driven through its own DBus API (com.system76.CosmicWorkspaces
    Show / Hide) and its Shown / Hidden signals, so its real state is always known.
  * Velocity-aware: a quick flick fires after a short distance, a slow swipe needs more.
  * Four-finger pinches count as swipes: libinput reports a slightly converging
    four-finger swipe as a pinch.
  * Only the touchpad is read. Keyboard input is never read.

Log: ~/.cache/cosmic-mission-control.log
"""
import argparse
import math
import os
import re
import signal
import subprocess
import sys
import time
from collections import deque
from pathlib import Path

VERSION = "1.4.0"


def _env(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


FIRE_V = _env("CMC_FIRE_V", 38)            # vertical travel that always fires (about mm)
FIRE_H = _env("CMC_FIRE_H", 40)            # horizontal travel for a workspace step (no flick shortcut)
FLICK_MIN = _env("CMC_FLICK_MIN", 18)      # a fast vertical flick may fire after this much travel...
FLICK_SPEED = _env("CMC_FLICK_SPEED", 300)  # ...if it moves at least this fast (units/s)
DOMINANCE = _env("CMC_DOMINANCE", 1.3)     # main axis must beat the other by this factor
SWITCH_GAP = _env("CMC_SWITCH_GAP", 0.3)   # minimum seconds between workspace steps
DRAG = os.environ.get("CMC_THREE_FINGER_DRAG", "1") != "0"   # three-finger drag on/off
DRAG_GRACE = _env("CMC_DRAG_GRACE", 0.35)  # seconds the drag survives lifted fingers (0 = drop at once)
DRAG_START = _env("CMC_DRAG_START", 0.8)   # finger travel before the button goes down (mm)
DRAG_DELAY = _env("CMC_DRAG_DELAY", 0.03)  # and at least this long, so a 4-finger landing never clicks
RESHOW_WINDOW = 0.6                        # re-show the overview if it hides this soon after a step

LOG_PATH = Path.home() / ".cache/cosmic-mission-control.log"
NUM = re.compile(r"(-?\d+\.\d+)/\s*(-?\d+\.\d+)")
MOTION = re.compile(r"(-?\d+\.\d+)/\s*([-+]?\d+\.\d+)\s*\(\s*([-+]?\d+\.\d+)/\s*([-+]?\d+\.\d+)")


class Log:
    def __init__(self, path=LOG_PATH, echo=False):
        self.path, self.echo, self.lines = path, echo, deque(maxlen=400)

    def __call__(self, msg):
        line = time.strftime("%H:%M:%S ") + msg
        self.lines.append(line)
        if self.echo:
            print(line, flush=True)
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text("\n".join(self.lines) + "\n")
        except OSError:
            pass


log = Log()


# --------------------------------------------------------------------------- parsing

def parse(line):
    """Turn one `libinput debug-events` line into an event dict, or None."""
    if "GESTURE_SWIPE" in line:
        kind = "swipe"
    elif "GESTURE_PINCH" in line:
        kind = "pinch"
    else:
        return None
    parts = line.split()
    try:
        i = next(n for n, p in enumerate(parts) if p.startswith("GESTURE_"))
        phase = parts[i].rsplit("_", 1)[1]                  # BEGIN / UPDATE / END
        t = float(parts[i + 1].lstrip("+").rstrip("s"))
        fingers = int(parts[i + 2])
    except (StopIteration, IndexError, ValueError):
        return None
    ev = {"kind": kind, "phase": phase, "t": t, "fingers": fingers,
          "dx": 0.0, "dy": 0.0, "cancelled": "cancelled" in line}
    if phase == "UPDATE":
        m = NUM.search(" ".join(parts[i + 3:]))           # first pair after the finger count
        if not m:
            return None
        ev["dx"], ev["dy"] = float(m.group(1)), float(m.group(2))
    return ev


class Detector:
    """Four-finger gestures from libinput fire a direction at most once. The same stream
    teaches the pointer curve (one-finger motion) and lets a click end a drag.
    Three-finger drag itself runs on raw touchpad frames (RawTouch), not on this stream."""

    def __init__(self, on_direction, drag=None, curve=None):
        self.on_direction, self.drag, self.curve = on_direction, drag, curve
        self._reset("swipe", 0.0)

    def _reset(self, kind, t):
        self.kind, self.t0, self.t, self.dx, self.dy, self.result = kind, t, t, 0.0, 0.0, None

    def feed(self, line):
        ev = parse(line)
        if not ev:
            if self.curve and "POINTER_MOTION" in line:
                self.curve.observe(line)
            elif self.drag and "POINTER_BUTTON" in line and "pressed" in line:
                self.drag.touch()
            return
        if ev["phase"] == "BEGIN":
            self._reset(ev["kind"], ev["t"])
        elif ev["phase"] == "UPDATE" and ev["fingers"] == 4 and self.result is None:
            self.t = ev["t"]
            self.dx += ev["dx"]
            self.dy += ev["dy"]
            self._check()
        elif ev["phase"] == "END" and ev["fingers"] == 4:
            ms = (ev["t"] - self.t0) * 1000
            log(f"{self.kind} dx={self.dx:+.0f} dy={self.dy:+.0f} {ms:.0f}ms"
                f"{' cancelled' if ev['cancelled'] else ''} -> {self.result or 'no action'}")

    def _ready(self, dist, threshold, flick):
        if dist >= threshold:
            return True
        speed = dist / max(self.t - self.t0, 1e-3)
        return flick and dist >= FLICK_MIN and speed >= FLICK_SPEED

    def _check(self):
        ax, ay = abs(self.dx), abs(self.dy)
        if ay > DOMINANCE * ax and self._ready(ay, FIRE_V, flick=True):
            self.result = self.on_direction("up" if self.dy < 0 else "down")
        elif ax > DOMINANCE * ay and self._ready(ax, FIRE_H, flick=False):
            # sideways stays deliberate: a workspace step should never feel twitchy
            self.result = self.on_direction("right" if self.dx > 0 else "left")


class PointerCurve:
    """Your pointer's acceleration, learned from normal one-finger movement.

    libinput reports every pointer motion with both its accelerated (pixels) and raw
    (touchpad units) delta. Their ratio at each finger speed is your exact pointer curve,
    including your speed setting. Three-finger drags reuse it, so a drag moves the cursor
    exactly as far as pointing would. Learned values persist across restarts.
    """
    # Seed: measured on a GXTP7863 touchpad at COSMIC speed 0.36 (speed in raw units/ms, px per unit)
    SEED = [(0.03, 0.183), (0.065, 0.218), (0.14, 0.293), (0.27, 0.333), (0.52, 0.339),
            (0.95, 0.339), (1.85, 0.339), (3.6, 0.346), (6.5, 0.461), (13.0, 0.55)]
    PATH = Path.home() / ".cache/cosmic-mission-control-curve.json"

    def __init__(self, path=None, persist=True):
        import json
        self.json, self.path, self.persist = json, path or self.PATH, persist
        self.points = {self._key(s): [g, 5] for s, g in self.SEED}   # key -> [gain, weight]
        self.prev_t, self.dirty, self.saved_at = None, False, 0.0
        if persist:
            try:
                for k, (g, w) in self.json.loads(self.path.read_text()).items():
                    self.points[int(k)] = [g, w]
            except Exception:
                pass

    @staticmethod
    def _key(speed):
        return int(round(math.log2(max(speed, 0.005) / 0.01) * 2))   # half-octave buckets

    @staticmethod
    def _speed(key):
        return 0.01 * 2 ** (key / 2)

    def observe(self, line):
        """Learn from one libinput POINTER_MOTION line."""
        parts = line.split()
        try:
            i = parts.index("POINTER_MOTION")
            t = float(parts[i + 1].lstrip("+").rstrip("s"))
        except (ValueError, IndexError):
            return
        m = MOTION.search(line)
        dt, self.prev_t = (t - self.prev_t) if self.prev_t else 0.0, t
        if not m or not 0.002 < dt < 0.03:
            return
        ax, ay, ux, uy = map(float, m.groups())
        raw = math.hypot(ux, uy)
        if raw < 1:
            return
        k = self._key(raw / (dt * 1000))
        g, w = self.points.get(k, [math.hypot(ax, ay) / raw, 0])
        w = min(w + 1, 200)
        self.points[k] = [g + (math.hypot(ax, ay) / raw - g) / w, w]
        self.dirty = True
        if self.persist and t - self.saved_at > 30:
            self.save(t)

    def save(self, t=0.0):
        if self.dirty:
            try:
                self.path.write_text(self.json.dumps({str(k): v for k, v in self.points.items()}))
            except OSError:
                pass
            self.dirty, self.saved_at = False, t

    def gain(self, speed):
        """Pixels per raw touchpad unit at this finger speed (raw units per ms)."""
        pts = sorted((self._speed(k), g) for k, (g, w) in self.points.items() if w >= 3)
        if speed <= pts[0][0]:
            return pts[0][1]
        for (s0, g0), (s1, g1) in zip(pts, pts[1:]):
            if speed <= s1:
                f = (math.log(speed) - math.log(s0)) / (math.log(s1) - math.log(s0))
                return g0 + (g1 - g0) * f
        return pts[-1][1]


class Dragger:
    """macOS three-finger drag, fed raw touchpad frames (finger count, centroid motion).

    idle -> armed      exactly three fingers touch
    armed -> dragging  they travel DRAG_START mm for DRAG_DELAY s: button down where they
                       landed, buffered motion replays, nothing is lost
    dragging -> grace  fingers lift: the drag survives DRAG_GRACE s so you can reposition
    grace -> dragging  three fingers return in time
    any -> idle        timeout, a click, or a fourth finger (which also blocks re-arming
                       until every finger lifts, so four-finger swipes never click)
    """

    def __init__(self, pointer, curve, later, cancel, units_per_mm=31.0):
        self.p, self.curve, self.later, self.cancel = pointer, curve, later, cancel
        self.mm = units_per_mm
        self.state, self.locked, self.timer, self.buf = "idle", False, None, []
        self.fx = self.fy = self.speed = 0.0
        self.t0 = self.travel = self.moved = self.finger_mm = self.stray = 0.0
        self.last_t = None

    def frame(self, count, dx, dy, t):
        dt = t - self.last_t if self.last_t is not None else 0.008
        self.last_t = t
        if count == 0:
            self.locked = False
        st = self.state
        if st == "idle":
            if count == 3 and not self.locked:
                self.state, self.t0, self.travel, self.buf = "armed", t, 0.0, []
            elif count >= 4:
                self.locked = True
        elif st == "armed":
            if count >= 4:
                self.state, self.locked = "idle", True
            elif count < 3:
                self.state = "idle"                       # a rest or a three-finger tap
            else:
                self.buf.append((dx, dy, dt))
                self.travel += math.hypot(dx, dy)
                if self.travel >= DRAG_START * self.mm and t - self.t0 >= DRAG_DELAY:
                    self.p.press()
                    self.state, self.moved, self.finger_mm, self.speed = "dragging", 0.0, 0.0, 0.0
                    for bx, by, bdt in self.buf:
                        self._emit(bx, by, bdt)
                    self.buf = []
        elif st == "dragging":
            if count == 3:
                self._emit(dx, dy, dt)
            elif count >= 4:
                self._drop()
                self.locked = True
            elif DRAG_GRACE <= 0:
                self._drop()
            else:
                self.state, self.stray = "grace", 0.0
                self.timer = self.later(int(DRAG_GRACE * 1000), self._drop)
        elif st == "grace":
            if count == 3:
                self._stop_timer()
                self.state, self.speed = "dragging", 0.0
            elif count >= 4:
                self._drop()
                self.locked = True
            elif count in (1, 2):
                self.stray += math.hypot(dx, dy)
                if self.stray > self.mm:                  # pointing with one or two fingers: drop
                    self._drop()

    def touch(self):
        """A physical click ends a drag at once."""
        if self.state in ("grace", "dragging"):
            self._drop()

    def _emit(self, dx, dy, dt):
        dist = math.hypot(dx, dy)
        if not dist:
            return
        self.finger_mm += dist / self.mm
        v = dist / max(dt * 1000, 1.0)                    # raw units per ms
        self.speed = v if not self.speed else self.speed * 0.5 + v * 0.5
        g = self.curve.gain(self.speed)
        self.fx += dx * g
        self.fy += dy * g
        ix, iy = int(self.fx), int(self.fy)               # keep sub-pixel remainders
        if ix or iy:
            self.fx -= ix
            self.fy -= iy
            self.moved += math.hypot(ix, iy)
            self.p.move(ix, iy)

    def _stop_timer(self):
        if self.timer is not None:
            self.cancel(self.timer)
            self.timer = None

    def _drop(self):
        self._stop_timer()
        if self.state in ("grace", "dragging"):
            self.p.release()
            log(f"three-finger drag: {self.finger_mm:.0f} mm of finger travel -> {self.moved:.0f} px")
        self.state, self.fx, self.fy = "idle", 0.0, 0.0
        return False


class RawTouch:
    """Reads the touchpad's raw multitouch frames (alongside libinput, never exclusively)
    and reports finger count and centroid motion per frame. Palms are ignored."""

    def __init__(self, path, on_frame):
        from evdev import InputDevice, ecodes as e
        self.e, self.dev, self.on_frame = e, InputDevice(path), on_frame
        absinfo = dict(self.dev.capabilities()[e.EV_ABS])
        self.units_per_mm = float(absinfo[e.ABS_MT_POSITION_X].resolution or 31)
        self.slots, self.cur, self.prev = {}, 0, {}

    def fileno(self):
        return self.dev.fd

    def read(self):
        e = self.e
        try:
            events = list(self.dev.read())
        except BlockingIOError:
            return True
        except OSError:
            return False                                  # device gone (suspend/unplug)
        for ev in events:
            if ev.type == e.EV_ABS:
                if ev.code == e.ABS_MT_SLOT:
                    self.cur = ev.value
                elif ev.code == e.ABS_MT_TRACKING_ID:
                    if ev.value < 0:
                        self.slots.pop(self.cur, None)
                    else:
                        self.slots[self.cur] = {"x": None, "y": None, "palm": False}
                elif self.cur in self.slots:
                    s = self.slots[self.cur]
                    if ev.code == e.ABS_MT_POSITION_X:
                        s["x"] = ev.value
                    elif ev.code == e.ABS_MT_POSITION_Y:
                        s["y"] = ev.value
                    elif ev.code == e.ABS_MT_TOOL_TYPE:
                        s["palm"] = ev.value == e.MT_TOOL_PALM
            elif ev.type == e.EV_SYN and ev.code == e.SYN_REPORT:
                self._frame(ev.timestamp())
        return True

    def _frame(self, t):
        now = {k: (s["x"], s["y"]) for k, s in self.slots.items()
               if s["x"] is not None and s["y"] is not None and not s["palm"]}
        both = [k for k in now if k in self.prev]
        dx = sum(now[k][0] - self.prev[k][0] for k in both) / len(both) if both else 0.0
        dy = sum(now[k][1] - self.prev[k][1] for k in both) / len(both) if both else 0.0
        if len(now) != len(self.prev):
            dx = dy = 0.0                                 # finger landed or lifted: no jump
        self.prev = now
        self.on_frame(len(now), dx, dy, t)


class VirtualPointer:
    """A uinput mouse. COSMIC is told to apply flat acceleration to it, so motion keeps
    the touchpad's own acceleration and never gets accelerated twice."""
    NAME = "cosmic-mission-control pointer"

    def __init__(self):
        from evdev import UInput, ecodes as e
        self.e = e
        self.ui = UInput({e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE],
                          e.EV_REL: [e.REL_X, e.REL_Y]}, name=self.NAME)
        self.down = False

    def move(self, dx, dy):
        self.ui.write(self.e.EV_REL, self.e.REL_X, dx)
        self.ui.write(self.e.EV_REL, self.e.REL_Y, dy)
        self.ui.syn()

    def press(self):
        self.ui.write(self.e.EV_KEY, self.e.BTN_LEFT, 1)
        self.ui.syn()
        self.down = True

    def release(self):
        if self.down:
            self.ui.write(self.e.EV_KEY, self.e.BTN_LEFT, 0)
            self.ui.syn()
            self.down = False

    def close(self):
        self.release()
        self.ui.close()


# --------------------------------------------------------------------------- actions

def session_env():
    """WAYLAND_DISPLAY and the DBus address of the live compositor, read at call time,
    so a service that started before the desktop still targets the right session."""
    env = dict(os.environ)
    try:
        pid = subprocess.run(["pidof", "cosmic-comp"], capture_output=True, text=True).stdout.split()[0]
        for kv in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
            k, _, v = kv.decode(errors="ignore").partition("=")
            if k in ("WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "DISPLAY"):
                env[k] = v
    except Exception:
        pass
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
    return env


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, env=session_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        log(f"could not run {cmd[0]}: {e}")


class OverviewBus:
    """The Workspaces Overview over DBus: Show/Hide calls, Shown/Hidden signals."""
    NAME = "com.system76.CosmicWorkspaces"
    PATH = "/com/system76/CosmicWorkspaces"

    def __init__(self):
        from gi.repository import Gio
        self.Gio = Gio
        os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", session_env()["DBUS_SESSION_BUS_ADDRESS"])
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.shown = False
        self.reshow_until = 0.0     # set right after a workspace step
        self.conn.signal_subscribe(None, self.NAME, None, self.PATH, None,
                                   Gio.DBusSignalFlags.NONE, self._on_signal)
        Gio.bus_watch_name_on_connection(self.conn, self.NAME, Gio.BusNameWatcherFlags.NONE,
                                         None, self._on_vanished)

    def _on_signal(self, _conn, _sender, _path, _iface, member, _params):
        if member == "Shown":
            self.shown = True
        elif member == "Hidden":
            if time.monotonic() < self.reshow_until:
                self.reshow_until = 0.0     # COSMIC closed it because of our step: bring it back once
                self._call("Show")
                log("overview hid after a workspace step, re-shown")
                return
            self.shown = False

    def _on_vanished(self, *_):
        self.shown = False          # overview process exited or restarted

    def _call(self, method):
        self.conn.call(self.NAME, self.PATH, self.NAME, method, None, None,
                       self.Gio.DBusCallFlags.NONE, 1000, None, None, None)

    def show(self):
        self._call("Show")

    def hide(self):
        self._call("Hide")


class SimBus:
    """Stand-in for OverviewBus in --dry-run, --replay and tests."""

    def __init__(self):
        self.shown, self.calls, self.reshow_until = False, [], 0.0

    def show(self):
        self.shown = True
        self.calls.append("Show")

    def hide(self):
        self.shown = False
        self.calls.append("Hide")


class Controller:
    """Maps a direction to an action given whether the overview is open."""

    def __init__(self, bus, run=spawn, clock=time.monotonic):
        self.bus, self.run, self.clock, self.last_step = bus, run, clock, -1e9

    def __call__(self, direction):
        open_ = self.bus.shown
        if direction == "up":
            if open_:
                return "overview already open"
            self.bus.show()
            return "show overview"
        if direction == "down":
            if open_:
                self.bus.hide()
                return "hide overview"
            self.run("cosmic-app-library")          # what Super+A runs
            return "app library"
        if not open_:
            return "desktop: COSMIC switches workspace"
        now = self.clock()
        if now - self.last_step < SWITCH_GAP:
            return "ignored: too soon after the last step"
        self.last_step = now
        self.bus.reshow_until = now + RESHOW_WINDOW
        self.run("ydotool", "key", f"super+ctrl+{'Right' if direction == 'right' else 'Left'}")
        return f"workspace {direction} in overview"


# --------------------------------------------------------------------------- runtime

def touchpad():
    out = subprocess.run(["libinput", "list-devices"], capture_output=True, text=True).stdout
    dev = None
    for line in out.splitlines():
        if line.startswith("Device:"):
            dev = line
        elif line.strip().startswith("Kernel:") and dev and "touchpad" in dev.lower():
            return line.split()[-1]
    return None


class Reader:
    """Runs `libinput debug-events` on the touchpad inside the GLib loop; restarts it on exit."""

    def __init__(self, detector, GLib):
        self.detector, self.GLib, self.proc, self.buf = detector, GLib, None, b""

    def start(self):
        dev = touchpad()
        if not dev:
            log("no touchpad found, retrying in 5 s")
            self.GLib.timeout_add_seconds(5, lambda: self.start() and False)
            return
        self.proc = subprocess.Popen(["libinput", "debug-events", "--device", dev],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.buf = b""
        self.GLib.io_add_watch(self.proc.stdout.fileno(), self.GLib.PRIORITY_HIGH,
                               self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR, self._on_data)
        log(f"reading {dev}")

    def _on_data(self, fd, cond):
        data = os.read(fd, 65536) if cond & self.GLib.IO_IN else b""
        if not data:
            log("touchpad reader stopped, restarting")
            self.stop()
            self.GLib.timeout_add_seconds(1, lambda: self.start() and False)
            return False
        self.buf += data
        *lines, self.buf = self.buf.split(b"\n")
        for line in lines:
            self.detector.feed(line.decode(errors="replace"))
        return True

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()


def run_live(dry_run):
    from gi.repository import GLib
    bus = SimBus() if dry_run else OverviewBus()
    run = (lambda *c: log("dry-run: " + " ".join(c))) if dry_run else spawn
    pointer = drag = curve = raw = None
    if DRAG:
        try:
            curve = PointerCurve()
            pointer = LogPointer() if dry_run else VirtualPointer()
            drag = Dragger(pointer, curve, later=lambda ms, fn: GLib.timeout_add(ms, fn),
                           cancel=GLib.source_remove)
            raw = RawWatch(drag, GLib)
        except Exception as e:                     # python3-evdev missing or no /dev/uinput access
            log(f"three-finger drag unavailable: {e}")
            drag = None
    reader = Reader(Detector(Controller(bus, run), drag, curve), GLib)
    loop = GLib.MainLoop()

    def quit_(*_):
        reader.stop()
        if pointer:
            pointer.close()                        # never leave the button held
        if curve:
            curve.save()
        loop.quit()
        return False

    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, quit_)
    log(f"cosmic-mission-control {VERSION} started"
        f"{', three-finger drag on' if drag else ''}{' (dry run)' if dry_run else ''}")
    reader.start()
    if raw:
        raw.start()
    loop.run()


class RawWatch:
    """Keeps a RawTouch reader attached to the GLib loop; reattaches after suspend or unplug."""

    def __init__(self, drag, GLib):
        self.drag, self.GLib, self.raw = drag, GLib, None

    def start(self):
        dev = touchpad()
        if not dev:
            self.GLib.timeout_add_seconds(5, lambda: self.start() and False)
            return
        self.raw = RawTouch(dev, self.drag.frame)
        self.drag.mm = self.raw.units_per_mm
        self.GLib.io_add_watch(self.raw.fileno(), self.GLib.PRIORITY_HIGH,
                               self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR, self._on_data)

    def _on_data(self, _fd, cond):
        if cond & (self.GLib.IO_HUP | self.GLib.IO_ERR) or not self.raw.read():
            log("raw touchpad reader lost, reattaching")
            self.drag.touch()
            self.GLib.timeout_add_seconds(1, lambda: self.start() and False)
            return False
        return True


class LogPointer:
    """Pointer stand-in for --dry-run and tests: records what would be sent."""

    def __init__(self):
        self.events, self.down = [], False

    def move(self, dx, dy):
        self.events.append(("move", dx, dy))

    def press(self):
        self.down = True
        self.events.append(("press",))

    def release(self):
        if self.down:
            self.down = False
            self.events.append(("release",))

    def close(self):
        self.release()


def run_replay(path):
    log.echo = True
    bus = SimBus()
    det = Detector(Controller(bus, run=lambda *c: log("run: " + " ".join(c))))
    for line in Path(path).read_text().splitlines():
        det.feed(line)


def main(argv=None):
    ap = argparse.ArgumentParser(description="macOS-style four-finger gestures for COSMIC.")
    ap.add_argument("--dry-run", action="store_true", help="read the touchpad but only log actions")
    ap.add_argument("--replay", metavar="FILE", help="feed saved `libinput debug-events` output, no touchpad")
    ap.add_argument("--version", action="version", version=VERSION)
    args = ap.parse_args(argv)
    if args.replay:
        run_replay(args.replay)
    else:
        log.echo = sys.stdout.isatty()
        run_live(args.dry_run)


if __name__ == "__main__":
    main()
