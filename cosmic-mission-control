#!/usr/bin/env python3
"""cosmic-mission-control: macOS-style four-finger gestures for the COSMIC desktop.

    up          open the Workspaces Overview
    down        close the overview, or open the App Library from the desktop
    left/right  inside the overview: switch workspace, overview stays open
                on the desktop: left to COSMIC, which already handles it

Design
  * One process, one GLib main loop. No threads, no helper processes per gesture.
  * The overview is driven through its own DBus API (com.system76.CosmicWorkspaces
    Show / Hide) and its Shown / Hidden signals, so its real state is always known.
  * Velocity-aware: a quick flick fires after a short distance, a slow swipe needs more.
  * Four-finger pinches count as swipes: libinput reports a slightly converging
    four-finger swipe as a pinch.
  * Only the touchpad is read. Keyboard input is never read.

Log: ~/.cache/cosmic-mission-control.log
"""
import argparse
import os
import re
import signal
import subprocess
import sys
import time
from collections import deque
from pathlib import Path

VERSION = "1.2.0"


def _env(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return default


FIRE_V = _env("CMC_FIRE_V", 38)            # vertical travel that always fires (about mm)
FIRE_H = _env("CMC_FIRE_H", 40)            # horizontal travel for a workspace step (no flick shortcut)
FLICK_MIN = _env("CMC_FLICK_MIN", 18)      # a fast vertical flick may fire after this much travel...
FLICK_SPEED = _env("CMC_FLICK_SPEED", 300)  # ...if it moves at least this fast (units/s)
DOMINANCE = _env("CMC_DOMINANCE", 1.3)     # main axis must beat the other by this factor
SWITCH_GAP = _env("CMC_SWITCH_GAP", 0.3)   # minimum seconds between workspace steps
RESHOW_WINDOW = 0.6                        # re-show the overview if it hides this soon after a step

LOG_PATH = Path.home() / ".cache/cosmic-mission-control.log"
NUM = re.compile(r"(-?\d+\.\d+)/\s*(-?\d+\.\d+)")


class Log:
    def __init__(self, path=LOG_PATH, echo=False):
        self.path, self.echo, self.lines = path, echo, deque(maxlen=400)

    def __call__(self, msg):
        line = time.strftime("%H:%M:%S ") + msg
        self.lines.append(line)
        if self.echo:
            print(line, flush=True)
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text("\n".join(self.lines) + "\n")
        except OSError:
            pass


log = Log()


# --------------------------------------------------------------------------- parsing

def parse(line):
    """Turn one `libinput debug-events` line into an event dict, or None."""
    if "GESTURE_SWIPE" in line:
        kind = "swipe"
    elif "GESTURE_PINCH" in line:
        kind = "pinch"
    else:
        return None
    parts = line.split()
    try:
        i = next(n for n, p in enumerate(parts) if p.startswith("GESTURE_"))
        phase = parts[i].rsplit("_", 1)[1]                  # BEGIN / UPDATE / END
        t = float(parts[i + 1].lstrip("+").rstrip("s"))
        fingers = int(parts[i + 2])
    except (StopIteration, IndexError, ValueError):
        return None
    ev = {"kind": kind, "phase": phase, "t": t, "fingers": fingers,
          "dx": 0.0, "dy": 0.0, "cancelled": "cancelled" in line}
    if phase == "UPDATE":
        m = NUM.search(" ".join(parts[i + 3:]))           # first pair after the finger count
        if not m:
            return None
        ev["dx"], ev["dy"] = float(m.group(1)), float(m.group(2))
    return ev


class Detector:
    """Accumulates one four-finger gesture and fires a direction at most once."""

    def __init__(self, on_direction):
        self.on_direction = on_direction
        self._reset("swipe", 0.0)

    def _reset(self, kind, t):
        self.kind, self.t0, self.t, self.dx, self.dy, self.result = kind, t, t, 0.0, 0.0, None

    def feed(self, line):
        ev = parse(line)
        if not ev:
            return
        if ev["phase"] == "BEGIN":
            self._reset(ev["kind"], ev["t"])
        elif ev["phase"] == "UPDATE" and ev["fingers"] == 4 and self.result is None:
            self.t = ev["t"]
            self.dx += ev["dx"]
            self.dy += ev["dy"]
            self._check()
        elif ev["phase"] == "END" and ev["fingers"] == 4:
            ms = (ev["t"] - self.t0) * 1000
            log(f"{self.kind} dx={self.dx:+.0f} dy={self.dy:+.0f} {ms:.0f}ms"
                f"{' cancelled' if ev['cancelled'] else ''} -> {self.result or 'no action'}")

    def _ready(self, dist, threshold, flick):
        if dist >= threshold:
            return True
        speed = dist / max(self.t - self.t0, 1e-3)
        return flick and dist >= FLICK_MIN and speed >= FLICK_SPEED

    def _check(self):
        ax, ay = abs(self.dx), abs(self.dy)
        if ay > DOMINANCE * ax and self._ready(ay, FIRE_V, flick=True):
            self.result = self.on_direction("up" if self.dy < 0 else "down")
        elif ax > DOMINANCE * ay and self._ready(ax, FIRE_H, flick=False):
            # sideways stays deliberate: a workspace step should never feel twitchy
            self.result = self.on_direction("right" if self.dx > 0 else "left")


# --------------------------------------------------------------------------- actions

def session_env():
    """WAYLAND_DISPLAY and the DBus address of the live compositor, read at call time,
    so a service that started before the desktop still targets the right session."""
    env = dict(os.environ)
    try:
        pid = subprocess.run(["pidof", "cosmic-comp"], capture_output=True, text=True).stdout.split()[0]
        for kv in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
            k, _, v = kv.decode(errors="ignore").partition("=")
            if k in ("WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR", "DISPLAY"):
                env[k] = v
    except Exception:
        pass
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
    return env


def spawn(*cmd):
    try:
        subprocess.Popen(cmd, env=session_env(), stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        log(f"could not run {cmd[0]}: {e}")


class OverviewBus:
    """The Workspaces Overview over DBus: Show/Hide calls, Shown/Hidden signals."""
    NAME = "com.system76.CosmicWorkspaces"
    PATH = "/com/system76/CosmicWorkspaces"

    def __init__(self):
        from gi.repository import Gio
        self.Gio = Gio
        os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", session_env()["DBUS_SESSION_BUS_ADDRESS"])
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.shown = False
        self.reshow_until = 0.0     # set right after a workspace step
        self.conn.signal_subscribe(None, self.NAME, None, self.PATH, None,
                                   Gio.DBusSignalFlags.NONE, self._on_signal)
        Gio.bus_watch_name_on_connection(self.conn, self.NAME, Gio.BusNameWatcherFlags.NONE,
                                         None, self._on_vanished)

    def _on_signal(self, _conn, _sender, _path, _iface, member, _params):
        if member == "Shown":
            self.shown = True
        elif member == "Hidden":
            if time.monotonic() < self.reshow_until:
                self.reshow_until = 0.0     # COSMIC closed it because of our step: bring it back once
                self._call("Show")
                log("overview hid after a workspace step, re-shown")
                return
            self.shown = False

    def _on_vanished(self, *_):
        self.shown = False          # overview process exited or restarted

    def _call(self, method):
        self.conn.call(self.NAME, self.PATH, self.NAME, method, None, None,
                       self.Gio.DBusCallFlags.NONE, 1000, None, None, None)

    def show(self):
        self._call("Show")

    def hide(self):
        self._call("Hide")


class SimBus:
    """Stand-in for OverviewBus in --dry-run, --replay and tests."""

    def __init__(self):
        self.shown, self.calls, self.reshow_until = False, [], 0.0

    def show(self):
        self.shown = True
        self.calls.append("Show")

    def hide(self):
        self.shown = False
        self.calls.append("Hide")


class Controller:
    """Maps a direction to an action given whether the overview is open."""

    def __init__(self, bus, run=spawn, clock=time.monotonic):
        self.bus, self.run, self.clock, self.last_step = bus, run, clock, -1e9

    def __call__(self, direction):
        open_ = self.bus.shown
        if direction == "up":
            if open_:
                return "overview already open"
            self.bus.show()
            return "show overview"
        if direction == "down":
            if open_:
                self.bus.hide()
                return "hide overview"
            self.run("cosmic-app-library")          # what Super+A runs
            return "app library"
        if not open_:
            return "desktop: COSMIC switches workspace"
        now = self.clock()
        if now - self.last_step < SWITCH_GAP:
            return "ignored: too soon after the last step"
        self.last_step = now
        self.bus.reshow_until = now + RESHOW_WINDOW
        self.run("ydotool", "key", f"super+ctrl+{'Right' if direction == 'right' else 'Left'}")
        return f"workspace {direction} in overview"


# --------------------------------------------------------------------------- runtime

def touchpad():
    out = subprocess.run(["libinput", "list-devices"], capture_output=True, text=True).stdout
    dev = None
    for line in out.splitlines():
        if line.startswith("Device:"):
            dev = line
        elif line.strip().startswith("Kernel:") and dev and "touchpad" in dev.lower():
            return line.split()[-1]
    return None


class Reader:
    """Runs `libinput debug-events` on the touchpad inside the GLib loop; restarts it on exit."""

    def __init__(self, detector, GLib):
        self.detector, self.GLib, self.proc, self.buf = detector, GLib, None, b""

    def start(self):
        dev = touchpad()
        if not dev:
            log("no touchpad found, retrying in 5 s")
            self.GLib.timeout_add_seconds(5, lambda: self.start() and False)
            return
        self.proc = subprocess.Popen(["libinput", "debug-events", "--device", dev],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.buf = b""
        self.GLib.io_add_watch(self.proc.stdout.fileno(), self.GLib.PRIORITY_HIGH,
                               self.GLib.IO_IN | self.GLib.IO_HUP | self.GLib.IO_ERR, self._on_data)
        log(f"reading {dev}")

    def _on_data(self, fd, cond):
        data = os.read(fd, 65536) if cond & self.GLib.IO_IN else b""
        if not data:
            log("touchpad reader stopped, restarting")
            self.stop()
            self.GLib.timeout_add_seconds(1, lambda: self.start() and False)
            return False
        self.buf += data
        *lines, self.buf = self.buf.split(b"\n")
        for line in lines:
            self.detector.feed(line.decode(errors="replace"))
        return True

    def stop(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()


def run_live(dry_run):
    from gi.repository import GLib
    bus = SimBus() if dry_run else OverviewBus()
    run = (lambda *c: log("dry-run: " + " ".join(c))) if dry_run else spawn
    reader = Reader(Detector(Controller(bus, run)), GLib)
    loop = GLib.MainLoop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda *_: (reader.stop(), loop.quit()) and False)
    log(f"cosmic-mission-control {VERSION} started{' (dry run)' if dry_run else ''}")
    reader.start()
    loop.run()


def run_replay(path):
    log.echo = True
    bus = SimBus()
    det = Detector(Controller(bus, run=lambda *c: log("run: " + " ".join(c))))
    for line in Path(path).read_text().splitlines():
        det.feed(line)


def main(argv=None):
    ap = argparse.ArgumentParser(description="macOS-style four-finger gestures for COSMIC.")
    ap.add_argument("--dry-run", action="store_true", help="read the touchpad but only log actions")
    ap.add_argument("--replay", metavar="FILE", help="feed saved `libinput debug-events` output, no touchpad")
    ap.add_argument("--version", action="version", version=VERSION)
    args = ap.parse_args(argv)
    if args.replay:
        run_replay(args.replay)
    else:
        log.echo = sys.stdout.isatty()
        run_live(args.dry_run)


if __name__ == "__main__":
    main()
